{
  "name": "gh600-agentic-ai-study-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Source-grounded GH-600 Developing in Agentic AI Systems study platform.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "node scripts/generate-seo-pages.mjs --public-only && vite build && node scripts/generate-seo-pages.mjs --dist",
    "preview": "vite preview --host 0.0.0.0",
    "curate:lessons": "node scripts/curate-final-lessons.mjs",
    "curate:templates": "node scripts/curate-template-recommendations.mjs",
    "audit:lessons": "node scripts/audit-lesson-quality.mjs",
    "qa:content": "node scripts/qa-content.mjs",
    "qa:lessons": "node scripts/check-lesson-quality.mjs",
    "data:accuracy": "node scripts/check-data-accuracy.mjs",
    "check:sources": "node scripts/check-source-currentness.mjs",
    "check": "npm run build && npm run check:sources && npm run qa:content && npm run qa:lessons && npm run data:accuracy && npm run audit:lessons"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest"
  },
  "devDependencies": {},
  "keywords": [
    "GH-600",
    "GitHub Copilot",
    "Agentic AI",
    "MCP",
    "certification"
  ],
  "license": "MIT"
}
